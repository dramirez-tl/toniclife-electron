# URL del backend toniclife-api. Sin /api/v1 al final, el cliente lo agrega.
VITE_API_URL=http://localhost:3001/api/v1

# Entorno de la app: development | staging | production.
# Controla los bloques de diagnóstico (ruta de datos en la pantalla de
# activación, etc.): visibles en development/staging, OCULTOS en production.
# Default si se omite: production en `vite build`, development en `npm run dev`.
# Para el paquete de sucursales (npm run release) NO la definas o usa production.
VITE_APP_ENV=development
